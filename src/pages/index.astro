---
import Layout from '../layouts/Layout.astro';
import Feed from '../components/Feed';
import { getPublishedPosts } from '../lib/notion';
import type { Post } from '../lib/notion';

// Page is pre-rendered at build time

let posts: Post[] = [];
let error = '';

try {
  posts = await getPublishedPosts();
} catch (e) {
  console.error("Failed to fetch Notion posts:", e);
  error = "Failed to load Digital Garden. Check API keys.";
}

// Calculate Topic Counts
const tagCounts: Record<string, number> = {};
posts.forEach(post => {
  post.tags.forEach(tag => {
    tagCounts[tag] = (tagCounts[tag] || 0) + 1;
  });
});

const uniqueTopics = Object.entries(tagCounts)
  .map(([name, count]) => ({ name, count }))
  .sort((a, b) => a.name.localeCompare(b.name));
---

<Layout title="priyansh singara's thoughts">
  {error && (
    <div class="bg-red-50 text-red-600 p-4 rounded-lg border border-red-200">
      <p class="font-bold">Error:</p>
      <p>{error}</p>
    </div>
  )}

  {!posts.length && !error && (
    <div class="text-text-muted italic py-12 text-center">
      Garden is currently empty. Write something in Notion!
    </div>
  )}

  {posts.length > 0 && (
    <div class="flex flex-col gap-[36px] mt-[36px]">
      <!-- Divider 1 -->
      <hr class="border-0 h-px w-full bg-ui-border !my-0" />

      <!-- Bio Section with internal 36px gap -->
      <section class="flex flex-col gap-[36px]">
        <p class="text-[18px] leading-[1.5] text-text-muted !m-0">
          I spend most of my time thinking of product ideas i wish existed. This space is for me to write in my unfiltered thoughts and observations! It's basically a brain dump that I can look back when I want to see how I used to think at a specific point in time. I'm big on cafe hopping, art and products in general. I largely have weird thoughts so proceed with caution...
        </p>
        
        <p class="text-[18px] leading-[1.5] text-text-muted !m-0">
          Reach out via <a href="mailto:priyanshsingara@gmail.com" class="text-text-main hover:text-text-muted transition-colors underline decoration-ui-border underline-offset-4">email</a>, <a href="https://twitter.com/priyanshsingara" class="text-text-main hover:text-text-muted transition-colors underline decoration-ui-border underline-offset-4">twitter</a>, <a href="https://www.linkedin.com/in/priyanshsingara/" class="text-text-main hover:text-text-muted transition-colors underline decoration-ui-border underline-offset-4">linkedin</a> or <a href="https://cal.com/priyanshsingara" class="text-text-main hover:text-text-muted transition-colors underline decoration-ui-border underline-offset-4">schedule time here</a>. You can also look at my portfolio at <a href="https://priyanshsingara.framer.website" class="text-text-main hover:text-text-muted transition-colors underline decoration-ui-border underline-offset-4">priyanshsingara.framer.website</a>, I trust you will like it.
        </p>
      </section>

      <!-- Divider 2 -->
      <hr class="border-0 h-px w-full bg-ui-border" />

      <!-- Feed (Tabs + Card Container) -->
      <Feed client:load posts={posts} topics={uniqueTopics} />
    </div>
  )}
</Layout>
