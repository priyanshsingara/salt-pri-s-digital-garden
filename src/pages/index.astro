---
import HomeLayout from '../layouts/HomeLayout.astro';
import Garden from '../components/Garden';
import ThinkingStatus from '../components/ThinkingStatus';
import type { GardenPost } from '../components/Garden';
import { getPublishedPosts } from '../lib/notion';
import type { Post } from '../lib/notion';

// Page is pre-rendered at build time

let posts: Post[] = [];
let error = '';

try {
  posts = await getPublishedPosts();
} catch (e) {
  console.error("Failed to fetch Notion posts:", e);
  error = "Failed to load Digital Garden. Check API keys.";
}

// The only colors a tag chip may ever use.
const TAG_COLORS = [
  '#C4D39B', // olive
  '#99F7FA', // cyan
  '#D99AEF', // purple
  '#68C0FF', // blue
  '#49CF00', // green
  '#AC8E00', // gold
  '#FF9A00', // orange
];

// Stable per-post hash so the color is the same on every build/render.
function hashString(str: string): number {
  let h = 0;
  for (let i = 0; i < str.length; i++) {
    h = (Math.imul(31, h) + str.charCodeAt(i)) | 0;
  }
  return Math.abs(h);
}

// Newest post (index 0) gets the highest number; e.g. 7 posts -> 007 at top.
// Add an 8th post in Notion and it becomes 008 at the top automatically.
const total = posts.length;
let prevColor = -1;
const gardenPosts: GardenPost[] = posts.map((post, i) => {
  let colorIndex = hashString(post.slug || post.title) % TAG_COLORS.length;
  // Avoid two identical chip colors back-to-back so the feed stays lively.
  if (colorIndex === prevColor) {
    colorIndex = (colorIndex + 1) % TAG_COLORS.length;
  }
  prevColor = colorIndex;

  return {
    number: String(total - i).padStart(3, '0'),
    title: post.title,
    slug: post.slug,
    tags: post.tags,
    color: TAG_COLORS[colorIndex],
  };
});
---

<HomeLayout title="priyansh is // thinking...">
  <div class="flex flex-col h-[100dvh] w-full">
    <!-- Header -->
    <header class="shrink-0 bg-white/[0.02] px-[32px] py-[16px] max-sm:px-5">
      <h1 class="!m-0 font-medium !text-white tracking-[-0.02em] leading-[1.15] text-[clamp(26px,6vw,72px)]">
        <span>priyansh is //</span><ThinkingStatus client:load />
      </h1>
    </header>

    {error && (
      <div class="px-[32px] py-4 text-[18px] text-tag-orange max-sm:px-5">
        {error}
      </div>
    )}

    {!error && gardenPosts.length === 0 && (
      <div class="px-[32px] py-8 text-[18px] text-text-muted max-sm:px-5">
        Garden is currently empty. Write something in Notion!
      </div>
    )}

    <!-- Feed + search (interactive) -->
    <Garden client:load posts={gardenPosts} />
  </div>
</HomeLayout>
