<script>
    // Wait for DOM to be fully loaded including React components
    function initAudioFeedback() {
        document.addEventListener('click', (e) => {
            const target = e.target;
            // Check if the clicked element or any of its parents have the data-audio-click attribute
            const audioTrigger = target.closest('[data-audio-click="true"]');

            if (audioTrigger) {
                // For links, prevent default navigation temporarily
                if (audioTrigger.tagName === 'A' && audioTrigger.href) {
                    e.preventDefault();
                    const href = audioTrigger.href;
                    
                    const audio = new Audio('/sounds/click-feedback.mp3');
                    audio.volume = 0.5;
                    
                    // Play audio and wait longer before navigating
                    const playPromise = audio.play();
                    
                    if (playPromise !== undefined) {
                        playPromise
                            .then(() => {
                                // Audio started playing, wait a bit for it to be audible
                                setTimeout(() => {
                                    window.location.href = href;
                                }, 150); // Increased delay to ensure audio is heard
                            })
                            .catch((error) => {
                                // Audio playback blocked or failed
                                console.warn('Audio playback failed:', error);
                                window.location.href = href;
                            });
                    } else {
                        // Fallback if play() doesn't return a promise
                        setTimeout(() => {
                            window.location.href = href;
                        }, 150);
                    }
                } else {
                    // For non-link elements, just play audio
                    const audio = new Audio('/sounds/click-feedback.mp3');
                    audio.volume = 0.5;
                    audio.play().catch((error) => {
                        console.warn('Audio playback failed:', error);
                    });
                }
            }
        });

        // Preload the audio to avoid delay on first click
        const preloadAudio = new Audio('/sounds/click-feedback.mp3');
        preloadAudio.preload = 'auto';
    }

    // Run after DOM is loaded
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initAudioFeedback);
    } else {
        // DOM already loaded, run immediately
        initAudioFeedback();
    }
</script>
